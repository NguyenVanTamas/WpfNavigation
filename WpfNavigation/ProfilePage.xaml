<Page x:Class="WpfNavigation.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfNavigation"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#F8FAFC"
      Title="ProfilePage">

    <Grid
        Margin="40"
    >
        <StackPanel>
            <TextBlock
                Text="Profil"
                FontSize="32"
                FontWeight="Bold"
                Foreground="#1E293B"
            />
            <TextBlock
                Text="Egy másik Page tartalma"
                FontSize="16"
                Foreground="#64748B"
                Margin="0,10,0,25"
            />
            <TextBlock
                Text="Név"
                FontWeight="Bold"
            />
            <TextBox
                x:Name="txtName"
                Height="40"
                FontSize="16"
                Padding="8"
                Margin="0,5,0,15"
            />
            <TextBlock
                Text="Email"
                FontWeight="Bold"
            />
            <TextBox
                x:Name="txtEmail"
                Height="40"
                FontSize="16"
                Padding="8"
                Margin="0,5,0,20"
            />
            <Button
                Content="Adatok ellenőrzése"
                Height="45"
                Margin="0,0,0,10"
            />
            <Button
                Content="Vissza"
                Height="45"
                Click="Back_Click"
            />
        </StackPanel>
    </Grid>
</Page>
