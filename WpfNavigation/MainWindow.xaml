<Window x:Class="WpfNavigation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfNavigation"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900">
    <Grid
        Margin="16"
    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
         <!-- Bal oldali menü-->
        <Border
            Grid.Column="0"
            Background="#1E293B"
        >
            <StackPanel
                Margin="20"
            >
                <TextBlock
                    Text="WPF Navigation"
                    Foreground="White"
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,10,0,30"
                />
                <Button
                    Content="Főoldal"
                    Height="45"
                    Margin="0,0,0,10"
                    Click="Home_Click"
                />
                <Button
                    Content="Profil"
                    Height="45"
                    Margin="0,0,0,25"
                    Click="Profile_Click"
                />
                <TextBlock
                    Text="Külön Window"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="0,0,0,10"
                />
                <Button
                    Content="Új ablak - Show()"
                    Height="45"
                    Margin="0,0,0,10"
                    Click="OpenWindow_Click"
                />
                <Button
                    Content="Modális - ShowDialog()"
                    Height="45"
                    Click="OpenDialog_Click"
                />
            </StackPanel>
        </Border>
        <Frame
            Grid.Column="1"
            x:Name="mainFrame"
            NavigationUIVisibility="Hidden"
        />
    </Grid>
</Window>
